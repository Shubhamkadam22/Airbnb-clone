<% layout('layouts/boilerplate') %>

    <h3>All LISTINGS </h3>
    
 

<div class="row row-cols-lg-2 row-cols-md-2 row-cols-sm-1 g-10">
  <% for(let listing of listings) { %>
  <div class="card col" style="width: 20rem;">
  <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image">
  <div class="card-body">
    <p class="card-text">
      <%= listing.title %> <br>
      Price: &#x20B9; <%= listing.price.toLocaleString("en-IN") %> / night 
    </p>
  </div>
</div>

<% } %>

</div>

