<% layout('layouts/boilerplate') %>

<div class="row mt-3">
  <div class="col-8 offset-2">
    <h2>Edit Listing</h2>

    <form method="POST" action="/listings/<%= listing._id %>?_method=PUT">
      <div class="mb-3">
        <label for="title" class="form-label">Title:</label>
        <input type="text" class="form-control" id="title" name="listing[title]" value="<%= listing.title %>" required>
      </div>

      <div class="mb-3">
        <label for="description" class="form-label">Description:</label>
        <textarea class="form-control" id="description" name="listing[description]" rows="4"><%= listing.description %></textarea>
      </div>

      <div class="mb-3">
        <label for="image" class="form-label">Image Link:</label>
        <input type="text" class="form-control" id="image" name="listing[image][url]" value="<%= listing.image ? listing.image.url : '' %>" placeholder="Upload image URL/Link">
      </div>

      <div class="row">
        <div class="mb-3 col-md-4">
          <label for="country" class="form-label">Country:</label>
          <input type="text" class="form-control" id="country" name="listing[country]" value="<%= listing.country %>" placeholder="Enter country name">
        </div>

        <div class="mb-3 col-md-8">
          <label for="price" class="form-label">Price:</label>
          <input type="number" class="form-control" id="price" name="listing[price]" value="<%= listing.price %>" placeholder="Enter price" min="0">
        </div>
      </div>

      <div class="mb-5">
        <label for="location" class="form-label">Location:</label>
        <input type="text" class="form-control" id="location" name="listing[location]" value="<%= listing.location %>" placeholder="Enter property location">
      </div>

      <button class="btn btn-dark btn2 mb-4" style="background-color: #f63307; border: none;" type="submit">UPDATE</button>
    </form>
  </div>
</div>