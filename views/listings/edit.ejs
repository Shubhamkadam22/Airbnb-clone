<% layout('layouts/boilerplate') %>
<body>
    <h2>Create a New Listing</h2>

    <form method="POST" action="/listings/<%= listing._id %>?_method=PUT">
        <div>
            <label for="title" class="form-label">Title:</label><br>
            <input type="text" class="form-control" id="title" name="listing[title]" value="<%= listing.title %>" required>
        </div>
        <br>

        <div>
            <label for="description" class="form-label">Description:</label><br>
            <textarea class="form-control" id="description" name="listing[description]"><%= listing.description %></textarea>
        </div>
        <br>

        <div>
            <label for="image" class="form-label">Image Link:</label><br>
            <input type="text" class="form-control" id="image" name="listing[image]" value="<%= listing.image %>" placeholder="Upload image URL/Link">
        </div>
        <br>

                <br>

        <div>
<div class="row ">
          <div class="mb3 col-md-4">
            <label for="country" class="form-label">Country:</label><br>
            <input type="text" class="form-control" id="country" name="listing[country]" value="<%= listing.country %>" placeholder="Enter country name">
        </div>

        <div class="mb3 col-md-4">
            <label for="price" class="form-label">Price:</label><br>
            <input type="number" class="form-control" id="price" name="listing[price]" value="<%= listing.price %>" placeholder="Enter price" min="0">
        </div>

</div>
            
        <div>
            <label for="location" class="form-label ">Location:</label><br>
            <input type="text"  class="form-control" name="listing[location]" value="<%= listing.location %>" placeholder="Enter property location">
        </div>
        <br>

        <button class="btn2" style="background-color: #f63307;" type="submit">UPDATE</button>
    </form>
</body>
