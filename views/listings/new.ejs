<% layout('layouts/boilerplate') %>

<div class="row mt-3">
  <div class="col-8 offset-2">
    <h2>Create a New Listing</h2>

    <form action="/listings" method="POST">
      <div class="mb-3">
        <label for="title" class="form-label">Title:</label>
        <input class="form-control" type="text" id="title" name="listing[title]" placeholder="Enter title" required>
      </div>

      <div class="mb-3">
        <label class="form-label" for="description">Description:</label>
        <textarea class="form-control" id="description" name="listing[description]" placeholder="Enter description" rows="4"></textarea>
      </div>

      <div class="mb-3">
        <label for="image" class="form-label">Image Link:</label>
        <input class="form-control" type="text" id="image" name="listing[image][url]" placeholder="Upload image URL/Link">
      </div>

      <div class="row">
        <div class="mb-3 col-md-4">
          <label for="price" class="form-label">Price:</label>
          <input class="form-control" type="number" id="price" name="listing[price]" placeholder="1200" min="0">
        </div>

        <div class="mb-3 col-md-8">
          <label for="country" class="form-label">Country:</label>
          <input class="form-control" type="text" id="country" name="listing[country]" placeholder="Enter country name">
        </div>
      </div>

      <div class="mb-3">
        <label for="location" class="form-label">Location:</label>
        <input class="form-control" type="text" id="location" name="listing[location]" placeholder="Enter property location">
      </div>

      <button class="btn text-white mb-4" style="background-color: #f63307; border: none;" type="submit">
        <b>ADD</b>
      </button>
    </form>
  </div>
</div>