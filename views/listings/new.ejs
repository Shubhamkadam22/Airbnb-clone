<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wanderlust - Add New Listing</title>
</head>
<body>
    <h2>Create a New Listing</h2>

    <form action="/listings" method="POST">
        <div>
            <label for="title">Title:</label><br>
            <input type="text" id="title" name="listing[title]" placeholder="Enter title" required>
        </div>
        <br>

        <div>
            <label for="description">Description:</label><br>
            <textarea id="description" name="listing[description]" placeholder="Enter description" rows="4" cols="30"></textarea>
        </div>
        <br>

        <div>
            <label for="image">Image Link:</label><br>
            <input type="text" id="image" name="listing[image]" placeholder="Upload image URL/Link">
        </div>
        <br>

        <div>
            <label for="price">Price:</label><br>
            <input type="number" id="price" name="listing[price]" placeholder="Enter price" min="0">
        </div>
        <br>

        <div>
            <label for="country">Country:</label><br>
            <input type="text" id="country" name="listing[country]" placeholder="Enter country name">
        </div>
        <br>

        <div>
            <label for="location">Location:</label><br>
            <input type="text" id="location" name="listing[location]" placeholder="Enter property location">
        </div>
        <br>

        <button type="submit">ADD</button>
    </form>
</body>
</html>