<% layout('layouts/boilerplate') %>
<body>

    <div class="col-8 offset-2 mt-5">
    <h2>Create a New Listing</h2>

    <form action="/listings" method="POST">
        <div class="mb3">
            <label for="title" class="form-label">Title:</label><br>
            <input class="form-control" type="text" id="title" name="listing[title]" placeholder="Enter title" required>
        </div>
        <br>

        <div class="mb3">
            <label  class="form-label" for="description">Description:</label><br>
            <textarea class="form-control" id="description" name="listing[description]" placeholder="Enter description" rows="4" cols="30"></textarea>
        </div>
        <br>

        <div class="mb3">
            <label for="image" class="form-label">Image Link:</label><br>
            <input class="form-control" type="text" id="image" name="listing[image]" placeholder="Upload image URL/Link">
        </div>
        <br>
   <div class="row ">
 <div class="mb3 col-md-4">
            <label for="price" class="form-label">Price:</label><br>
            <input class="form-control" type="text" id="price" name="listing[price]" placeholder="Enter price">
        </div>

        <div class="mb3 col-md-8">
            <label for="country" class="form-label">Country:</label><br>
            <input class="form-control" type="text" id="country" name="listing[country]" placeholder="Enter country name">
        </div>
  </div>
       
        <br>

        <div class="mb3">
            <label for="location" class="form-label">Location:</label><br>
            <input class="form-control" type="text" id="location" name="listing[location]" placeholder="Enter property location">
        </div>
        <br>
     <br>
        <button class="btn" style="background-color: #f63307;"  type="submit"><b>ADD</b></button>
    </form>
    </div>
</body>
